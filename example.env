# Template for local secrets.
# 1. Copy this file to ".env" in the same folder (the project root).
# 2. Fill in your own values after the = sign (no quotes, no spaces).
# 3. Restart the app. It reads .env automatically (see spring.config.import in application.yml).
#
# ".env" is git-ignored. This example file IS committed, so never put real keys in it.
# On Render, set the same names as environment variables instead of using a file.

# Razorpay TEST keys: Razorpay Dashboard (Test Mode) -> Settings -> API Keys
# Only test keys (rzp_test_...) are accepted; live keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Gmail SMTP) for running on your PC.
# Needs Google 2-Step Verification + an App Password (NOT your normal Gmail password).
# EMAIL_PROVIDER: console = print emails in the log (default), smtp = Gmail
EMAIL_PROVIDER=console
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional overrides (defaults are in application.yml)
# JWT_SECRET=a-random-string-of-at-least-32-characters
