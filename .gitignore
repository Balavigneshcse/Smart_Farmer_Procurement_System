# Build output
target/
out/

# IDE files
.idea/
*.iml
.vscode/

# Secrets and local settings - never commit these
.env
*.env
application-local.yml

# ...except the empty template, which shows which settings exist
!example.env

# Logs
*.log

# Excel's lock file while a workbook is open (staff-accounts.xlsx itself is committed; it is kept out of the Docker image)
~$*.xlsx

# Local notes and tools - kept on the PC, not part of the app
.claude/
skills-lock.json
PLAN.md
docs/
Problem Statement*.txt
